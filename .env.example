# Plantilla documentada. Copia a .env.development.local (desarrollo) y a .env.prod (producción).
# Ninguno se sube a git. `.env` y `.env.local` NO deben contener secretos: OpenNext los
# incrusta en el Worker que se despliega. `npm run build:worker` falla si encuentra alguno.
# No renombres .env.prod a .env.production: Next.js lo cargaría y acabaría en el Worker.

# --- Servicios ---
# memory: adaptadores en memoria, sin red (por defecto en desarrollo y pruebas)
# real:   Supabase, Turnstile y correo. En desarrollo apunta a Supabase LOCAL.
SERVICES=memory

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/confiaing/30min
# Idioma del evento en Calendly (es | en). Lo fija Calendly, no la página: si no coincide
# con el idioma del visitante, el bloque de agenda lo avisa. Hoy el evento está en inglés.
NEXT_PUBLIC_CALENDLY_LOCALE=en
CONTACT_EMAIL=hola@confia.ing

# --- Supabase ---
# .env.development.local: URL y clave que imprime `supabase start` (base local).
# .env.prod:  https://nojdfpoqmrjpxkaqskyv.supabase.co y la secret key del proyecto.
SUPABASE_URL=http://127.0.0.1:54321
# SECRETO. Solo servidor.
SUPABASE_SECRET_KEY=
# Pública por diseño; no se usa en la v1 (ADR-0002)
SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare Turnstile ---
# Claves de prueba oficiales (siempre aprueban). En .env.prod van las reales.
# La site key se incrusta al construir. Vacía = el formulario no carga la verificación
# (así corren las pruebas y `SERVICES=memory`).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Cloudflare Web Analytics ---
# Token público del sitio. Vacío = analítica de visitas desactivada.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- Correo de avisos (binding send_email, sin API key) ---
# NOTIFY_FROM debe ser del dominio con Email Routing; NOTIFY_TO, una dirección verificada allí.
# El límite de frecuencia (5 envíos por minuto) no lleva variable: es el binding
# CONTACT_RATE_LIMITER de wrangler.jsonc.
NOTIFY_FROM=web@confia.ing
NOTIFY_TO=
