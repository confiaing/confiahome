# Cabeceras de los archivos estáticos. Los sirve Cloudflare sin pasar por el Worker,
# así que las de src/lib/server/security/headers.ts no les llegan: van aquí.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Imágenes y logos: nada que ejecutar ni dónde incrustarse (un SVG puede llevar scripts).
/brand/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'

# Llevan la huella de su contenido en el nombre: no cambian nunca.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
