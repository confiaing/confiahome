{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "confiahome",
  // Entrada propia: envuelve a la de OpenNext (.open-next/worker.js) para añadir las cabeceras
  // de seguridad y la tarea programada (ADR-0016).
  "main": "worker/index.ts",
  // Única entrada pública: el dominio. La dirección workers.dev queda desactivada.
  "routes": [{ "pattern": "confia.ing", "custom_domain": true }],
  "workers_dev": false,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Producción usa servicios reales de forma explícita. En local, .dev.vars lo cambia a memory.
  // Solo lo que no es secreto ni propio de producción. Con `wrangler secret put` se cargan las
  // claves (SUPABASE_SECRET_KEY, TURNSTILE_SECRET_KEY), la dirección de aviso (NOTIFY_TO, un
  // buzón personal) y la dirección de la base (SUPABASE_URL): el preview local lee este
  // archivo y nunca debe poder apuntar a la base de producción.
  "vars": { "SERVICES": "real", "NOTIFY_FROM": "web@confia.ing" },
  // Aviso al equipo de cada consulta (ADR-0003). Solo envía a direcciones verificadas en Email Routing.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Antispam: 5 consultas por minuto y origen (ADR-0006).
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Eventos anónimos de analítica: holgado para una visita real, corto para un abuso.
    { "name": "EVENTS_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Tarea diaria (08:17 UTC): latido contra la pausa de Supabase y borrado por conservación.
  "triggers": { "crons": ["17 8 * * *"] },
  // Registros propios, sí. Los automáticos de cada petición, no: pueden guardar la IP y el agente del visitante.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
